# LLM API key
LLM_API_KEY=your_api_key_here

# LLM API base URL
LLM_BASE_URL=

# LLM model
LLM_MODEL=

# Whether to use JSON mode
LLM_JSON_MODE=false

# Maximum extraction attempts
LLM_MAX_ATTEMPTS=3

# Maximum LLM response tokens
LLM_MAX_TOKENS=2200

# Image rendering scale
LLM_IMAGE_SCALE=0.55

# JPEG image quality
LLM_IMAGE_QUALITY=35

# Maximum PDF text sent per page
LLM_MAX_PAGE_TEXT=1000

# Enable debug logging
DEBUG=false

# Accounting API URL
ACCOUNTING_API_URL=http://localhost:8080

# Accounting API key
ACCOUNTING_API_KEY=demo-key-1234

# Minimum confidence required for automatic processing
CONFIDENCE_THRESHOLD=0.85